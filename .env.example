# Clerk: copie os valores do ambiente de desenvolvimento.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Catálogo público: o token público deve ter apenas as permissões necessárias à loja.
NEXT_PUBLIC_HYGRAPH_KEY=
NEXT_PUBLIC_HYGRAPH_TOKEN=

# Backoffice: estas variáveis nunca devem receber o prefixo NEXT_PUBLIC_.
HYGRAPH_ENDPOINT=
HYGRAPH_ADMIN_TOKEN=
# IDs Clerk autorizados, separados por vírgula (ex.: user_abc,user_def).
BACKOFFICE_ADMIN_USER_IDS=

# Mock local do backoffice (ignorado em produção). Mantém autenticação Clerk.
BACKOFFICE_MOCK_DATA=false
# Demo sem Clerk: requer mock de dados e NODE_ENV=development. Nunca usar publicamente.
BACKOFFICE_MOCK_AUTH=false
# Ativado automaticamente por npm run dev:mock para as páginas da loja.
NEXT_PUBLIC_LOCAL_DEMO=false
